/*
* RedBlackTree represents the entire data structure by keeping
* track of the root node in the tree.
*/

//Tree keeps track of root for searching and traversal.
//Can be null (if empty), or a node.
class RedBlackTree<T> {
    private root: Node1<T> | null;
    //uses comparator for insertions.
    private compare: (a: T, b: T) => number;
    
    private size: number;

    //initializes tree to be initially empty
    constructor(compare: (a: T, b: T ) => number) {
        this.root = null;
        this.compare = compare;
        this.size = 0;
    }

    /*
    * instance methods for RedBlackTree
    */

    /*
    * Creates node from value x and inserts into this and
    * restores properties of Red-Black trees after insertion.
    * 
    * Calls locateParent and insertFixUp which both take O(h) time.
    * It also does some constant operations and checks.
    * Therefore insertion, is in O(h).
    */
    public insert(x: T) {
        //y is parent node for z
        let xParent = this.locateParent(x);

        //create new node to be inserted
        let xNode = new Node1<T>(x);

        //update z's parent
        xNode.parent = xParent;

        //if parent is null, x is the root
        //if x value is less than parent, then left child
        //else right child
        if (xParent === null) {
            this.root = xNode;
        } else if (this.compare(xNode.value, xParent.value) < 0) {
            xParent.left = xNode;
        } else {
            xParent.right = xNode;
        }

        //call insertFixUp to satisfy Red-Black tree properties
        this.insertFixUp(xNode);

        this.size++;
    }

    /*
    * helper methods for Insertion
    */

    /*
    * Finds parent for newly inserted node where z is the value
    * for the new node.
    * 
    * At worst, iterates over the height of tree and goes to bottom.
    * Therefore, locateParent is in O(h).
    */
   private locateParent(z: T): Node1<T> | null {
    //Start at root
    let x = this.root;
    let y: Node1<T> | null = null;
    
    //traverse as normal BST.
    //while there's still somewhere to go
    while(x !== null) {
        y = x;
        if (this.compare(z, x.value) < 0) {
            x = x.left;
        } else {
            x = x.right;
        }
    }
    //y is parent node for new node to be inserted
    return y;
   }

   /*
   * Restore properties of Red-Black Tree after insertion.
   *
   * A is called which takes O(h) time and B and C are called at
   * most onces which takes O(1) time.
   * Therefore, insertFixUp is in O(h).
   */
   private insertFixUp(x: Node1<T>) {
    this.insertFixUpA(x);

    //restores property two of Red Black Trees.
    if (this.root !== null) {
        this.root.color = "BLACK";
    }
   }

   private locateSibling(x: Node1<T>): Node1<T> | null {
    let xParent = x.parent;
    //Parent is root. no siblings
    if (xParent === null) {
        return null;
    }

    if (xParent.left === x) {
        return xParent.right;
    }
    return xParent.left;
   }

   /*
   * Handles case where x's parent and auncle are both red.
   *
   * Reassigns colors of parent, auncle, and grandparent of
   * x and repeats on grandparent, potentially going to the
   * root.
   * Therefore insertFixUpA is in O(h).
   */
   private insertFixUpA(x: Node1<T>) {
    while (x.parent !== null && x.parent.color === "RED") {
        let xAuncle = this.locateSibling(x.parent);
        //if null, color is black
        if (xAuncle === null || xAuncle.color === "BLACK") {
            this.insertFixUpB(x);
            return;
        }

        //change their colors to black
       x.parent.color = "BLACK";
       xAuncle.color = "BLACK";

        //change x's grandparent's color to red and repreat the process
        if (x.parent.parent !== null) {
            x = x.parent.parent;
            x.color = "RED";
        }
    }
   }

   /*
   * Handles case where x's parent is red and auncle is black and 
   * x is a right child and it's parent is a left or vise-versa.
   * 
   * This method does a couple of checks, calls locateSibling which
   * is in O(1), and then either does a left or right rotation which
   * is also in O(1).
   * Therefore, insertFixUpB is in O(1).
   */
   private insertFixUpB(x: Node1<T>) {
    if (x.parent === null || x.parent.color === "BLACK") {
        return
    }

    let xParent = x.parent;

    //checking if auncle is black or null
    let xAuncle = this.locateSibling(xParent);
    if (xAuncle !== null && xAuncle.color === "RED"){
        return;
    }

    let xGrandParent  = xParent.parent;

    //Checks if RL or LR situation and performs appropriate rotation that would put you in case III
    if (xParent !== null && xGrandParent !== null && x === xParent.right && xParent === xGrandParent.left) {
        this.leftRotate(xParent);
    } else if (xParent !== null && xGrandParent !== null && x === xParent.left && xParent === xGrandParent.right) {
        this.rightRotate(xParent);
    }
    this.insertFixUpC(x);
   }

   /*
   * Peforms a left rotation on this about the node x.
   *
   * Performs a fixed number of operations independent
   * on the size of this.
   * Therefore, leftRotation is in O(1).
   */
   private leftRotate(x: Node1<T>) {
    if (x === null || x.right === null) {
        return;
    }
    let y = x.right;
    x.right = y.left;
    if (y.left !== null) {
        y.left.parent = x;
    }

    y.parent = x.parent;
    if (x.parent === null) {
        this.root = y;
    } else if (x === x.parent.left) {
        x.parent.left = y;
    } else {
        x.parent.right = y;
    }

    y.left = x;
    x.parent = y;
   }

   /*
   * Peforms a right rotation on this about the node x.
   *
   * Performs a fixed number of operations independent
   * on the size of this.
   * Therefore, rightRotation is in O(1).
   */
   private rightRotate(x: Node1<T>) {
    if (x === null || x.left === null) {
        return;
    }
    let y = x.left;
    x.left = y.right;
    if (y.right !== null) {
        y.right.parent = x;
    }

    y.parent = x.parent;
    if (x.parent === null) {
        this.root = y;
    } else if (x === x.parent.right) {
        x.parent.right = y;
    } else {
        x.parent.left = y;
    }

    y.right = x;
    x.parent = y;
   }

   /*
   * Handles case where x.parent is red, x.auncle is black,
   * and x and x.parent are both either left or right children.
   *
   * Does a fixed amount of checks and constant operations,
   * calls locateSibling and either left or right rotate which
   * both are in O(1).
   * Therefore, insertFixUpC is in O(1).
   */
   private insertFixUpC(x: Node1<T>) {
    if (x.parent === null || x.parent.color === "BLACK") {
        return
    }

    let xParent = x.parent;

    //checking if auncle is black or null
    let xAuncle = this.locateSibling(xParent);
    if (xAuncle !== null && xAuncle.color === "RED"){
        return;
    }
    
    let xGrandParent = xParent.parent;

    //checking if x and xParent are both left or right children
    if (xParent !== null && xGrandParent !== null && x === xParent.left && xParent === xGrandParent.left) {
        this.rightRotate(xGrandParent);
        xParent.color = "BLACK";
        xGrandParent.color = "RED";
    } else if (xParent !== null && xGrandParent !== null && x === xParent.right && xParent === xGrandParent.right) {
        this.leftRotate(xGrandParent);
        xParent.color = "BLACK";
        xGrandParent.color = "RED";
    }
   }

    /*
    * Deletes x from this and restores properties
    * of Red-Black Tree after deletion.
    * 
    * 
    */
   public delete(x: Node1<T>) {
    let y = x;
    let color = y.color;
    let z: Node1<T>;
    if (x.left === null && x.right !== null) {
        z = x.right;
        this.transplant(x, x.right);
    } else if (x.right === null && x.left !== null) {
        this.transplant(x, x.left);
    } else if (x.right !== null && y.right !== null){
        y = this.treeMin(x.right);
        color = y.color;
        z = y.right;
        if (y.parent === x && z !== null) {
            z.parent = y;
        } else if (y.right !== null){
            this.transplant(y, y.right);
            y.right = x.right;
            y.right.parent = y;
        }
        this.transplant(x, y);
        y.left = x.left;
        if (z !== null && y.left !== null) {
            y.left.parent = y;
            y.color = z.color;
        }
    }
    if (color === "BLACK") {
        this.deleteFixUp(z);
    }

    this.size--;
   }

   /*
   * Replaces the sub-tree rooted at x with the sub-tree
   * rooted at y.
   * 
   * This performs a constant number of operations independent
   * on the size of this.
   * Therefore, transplant is in O(1).
   */
   private transplant(x: Node1<T>, y: Node1<T>) {
    if (x.parent === null) {
        this.root = y;
    } else if (x === x.parent.left) {
        x.parent.left = y;
    } else {
        x.parent.right = y;
    }
    y.parent = x.parent;
   }

   /*
   * Returns the node that contains the minimum value
   * rooted at x.
   * 
   * Continously goes left until reaches bottom. At worst
   * goes through the entire height of this.
   * Therefore, treeMin is in O(h).
   */
   private treeMin(x: Node1<T>): Node1<T> {
    while (x.left !== null) {
        x = x.left;
    }
    return x;
   }

   /*
   *Restores properties of Red-Black Tree after deletion.
   *
   * 
   */
   private deleteFixUp(x: Node1<T>) {
    while (x.parent !== null && x.color === "BLACK") {
        let xParent = x.parent;
        if (x === xParent.left && xParent.right !== null) {
            let s = xParent.right;
            if (s.color === "RED") {
                s.color = "BLACK";
                xParent.color = "RED";
                this.leftRotate(xParent);
                s = xParent.right;
            }
            if (s.left !== null && s.right !== null && s.left.color === "BLACK" && s.right.color === "BLACK") {
                s.color = "RED";
                x = xParent;
            } else {
                if (s.right !== null && s.left !== null && s.right.color == "BLACK") {
                    s.left.color = "BLACK";
                    s.color = "RED";
                    this.rightRotate(s);
                    s = xParent.right;
                }
                s.color = xParent.color;
                xParent.color = "BLACK";
                if (s.right !== null) {
                    s.right.color = "BLACK";
                }
                this.leftRotate(xParent);
            }
        } else if (x === xParent.right && xParent.left !== null) {
            let s = xParent.left;
            if (s.color === "RED") {
                s.color = "BLACK";
                xParent.color = "RED";
                this.rightRotate(xParent);
                s = xParent.left;
            }
            if (s.left !== null && s.right !== null && s.left.color === "BLACK" && s.right.color === "BLACK") {
                s.color = "RED";
                x = xParent;
            } else {
                if (s.right !== null && s.left !== null && s.left.color == "BLACK") {
                    s.right.color = "BLACK";
                    s.color = "RED";
                    this.leftRotate(s);
                    s = xParent.left;
                }
                s.color = xParent.color;
                xParent.color = "BLACK";
                if (s.left !== null) {
                    s.left.color = "BLACK";
                }
                this.rightRotate(xParent);
            }
        }
    }
    x.color = "BLACK";
   }

   /*
   * Returns node with value k or null if no
   * node contains value k.
   * 
   * In worst case, no node has value k or it
   * is at the bottom of tree, so goes through the
   * entire height of the tree.
   * Therefore, searchNode is in O(h).
   */
   public searchNode(k: T): Node1<T> | null {
    let x = this.root;
    while (x !== null && this.compare(k, x.value) !== 0) {
        if (this.compare(k, x.value) < 0) {
            x = x.left;
        } else {
            x = x.right;
        }
    }
    return x;
    }

    /*
    * Returns the number of nodes in this.
    *
    * Size is constantly updated through function calls.
    * Therefore, sizeOfTree is in O(1).
    */
    public sizeOfTree(): number {
        return this.size;
    }
}