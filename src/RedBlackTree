    }
    
    //traverse as normal BST
    while(x.left !== null && x.right !== null) {
        y = x;
        if (this.compare(z, x.value) < 0) {
            x = x.left;
        } else {
            x = x.right;
        }
    }
    //y is parent node for new node to be inserted
