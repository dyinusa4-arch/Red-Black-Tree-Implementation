            return;
        }

        //change their colors to black
       x.parent.color = "BLACK";
       xAuncle.color = "BLACK";

        //change x's grandparent's color to red and repreat the process
        if (x.parent.parent !== null) {
            x = x.parent.parent;
            x.color = "RED";
        }
    }
   }

