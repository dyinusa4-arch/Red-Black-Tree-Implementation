/*
* RedBlackTree represents the entire data structure by keeping
* track of the root node in the tree.
*/

//Tree keeps track of root for searching and traversal.
//Can be null (if empty), or a node.
class RedBlackTree<T> {
    private root: Node1<T> | null;
    //uses comparator for insertions.
    private compare: (a: T, b: T) => number;

    //initializes tree to be initially empty
    constructor(compare: (a: T, b: T ) => number) {
        this.root = null;
        this.compare = compare;
    }

    /*
    * instance methods for RedBlackTree
    */

    /*
    * Insertion
    */
    public insert(x: T) {
        //y is parent node for z
        let xParent = this.locateParent(x);

        //create new node to be inserted
        let xNode = new Node1<T>(x);

        //update z's parent
        xNode.parent = xParent;

        //if parent is null, x is the root
        //if x value is less than parent, then left child
        //else right child
        if (xParent === null) {
            this.root = xNode;
        } else if (this.compare(xNode.value, xParent.value) < 0) {
            xParent.left = xNode;
        } else {
            xParent.right = xNode;
        }

        //call insertFixUp to satisfy Red-Black tree properties
        this.insertFixUp(xNode);
    }

    /*
    * helper methods for Insertion
    */
   private locateParent(z: T): Node1<T> | null {
    //Start at root
    let x = this.root;
    let y = null;

    //return null if tree is empty
    if (x === null) {
        return null;
    }
    
    //traverse as normal BST
    while(x.left !== null && x.right !== null) {
        y = x;
        if (this.compare(z, x.value) < 0) {
            x = x.left;
        } else {
            x = x.right;
        }
    }
    //y is parent node for new node to be inserted
    return y;
   }

   private insertFixUp(x: Node1<T>) {
    this.insertFixUpA(x);
    if (x.parent !== null && x.parent.color === "RED") {
        this.insertFixUpB(x);
        this.insertFixUpC(x);
    }

    //restores property two of Red Black Trees.
    if (this.root !== null) {
        this.root.color = "BLACK";
    }
   }

   private locateSibling(x: Node1<T>): Node1<T> | null {
    let xParent = x.parent;
    //Parent is root. no siblings
    if (xParent === null) {
        return null;
    }

    if (xParent.left === x) {
        return xParent.right;
    }
    return xParent.left;
   }

   /*
   * Handles case where x's parent and auncle are both red.
   */
   private insertFixUpA(x: Node1<T>) {
    while (x.parent !== null && x.parent.color === "RED") {
        let xAuncle = this.locateSibling(x.parent);
        //if null, color is black
        if (xAuncle === null || xAuncle.color === "BLACK") {
            return;
        }

        //change their colors to black
       x.parent.color = "BLACK";
       xAuncle.color = "BLACK";

        //change x's grandparent's color to red and repreat the process
        if (x.parent.parent !== null) {
            x = x.parent.parent;
            x.color = "RED";
        }
    }
   }

   private insertFixUpB(x: Node1<T>) {
    if (x.parent === null || x.parent.color === "BLACK") {
        return
    }

    let xParent = x.parent;
    let xGrandParent  = xParent.parent;

    if (xParent !== null && xGrandParent !== null && x === xParent.right && xParent === xGrandParent.left) {
        x = xParent;
        this.rightRotate(x);
    } else if (xParent !== null && xGrandParent !== null && x === xParent.right && xParent === xGrandParent.right) {
        x = xParent;
        this.leftRotate(xGrandParent);
    }
   }

   private leftRotate(x: Node1<T>) {
    if (x === null || x.right === null) {
        return;
    }
    let y = x.right;
    x.right = y.left;
    if (y.left !== null) {
        y.left.parent = x;
    }

    y.parent = x.parent;
    if (x.parent === null) {
        this.root = y;
    } else if (x === x.parent.left) {
        x.parent.left = y;
    } else {
        x.parent.right = y;
    }

    y.left = x;
    x.parent = y;
   }

   private rightRotate(x: Node1<T>) {
    if (x === null || x.left === null) {
        return;
    }
    let y = x.left;
    x.left = y.right;
    if (y.right !== null) {
        y.right.parent = x;
    }

    y.parent = x.parent;
    if (x.parent === null) {
        this.root = y;
    } else if (x === x.parent.right) {
        x.parent.right = y;
    } else {
        x.parent.left = y;
    }

    y.right = x;
    x.parent = y;
   }

   private insertFixUpC(x: Node1<T>) {
    if (x.parent === null || x.parent.color === "BLACK") {
        return
    }

    let xParent = x.parent;
    let xGrandParent  = xParent.parent;

    if (xParent !== null && xGrandParent !== null && x === xParent.left && xParent === xGrandParent.left) {
        this.rightRotate(xGrandParent);
        xParent.color = "BLACK";
        xGrandParent.color = "RED";
    } else if (xParent !== null && xGrandParent !== null && x === xParent.right && xParent === xGrandParent.right) {
        this.leftRotate(xGrandParent);
        xParent.color = "BLACK";
        xGrandParent.color = "RED";
    }
   }

    /*
    * Deletion
    */
   public delete(x: Node1<T>) {
    let y = x;
    let color = y.color;
    let z: Node1<T>;
    if (x.left === null && x.right !== null) {
        //let z = x.right;
        this.transplant(x, x.right);
    } else if (x.right === null && x.left !== null) {
        this.transplant(x, x.left);
    } else if (x.right !== null){
        y = this.treeMin(x.right);
        color = y.color;
        z = y.right;
        if (y.parent === x && z !== null) {
            z.parent = y;
        } else if (y.right !== null){
            this.transplant(y, y.right);
            y.right = x.right;
            y.right.parent = y;
        }
        this.transplant(x, y);
        y.left = x.left;
        if (y !== null && y.left !== null) {
            y.left.parent = y;
            y.color = z?.color;
        }
    }
    if (color === "BLACK") {
        this.deleteFixUp(z);
    }
   }

   private transplant(x: Node1<T>, y: Node1<T>) {
    if (x.parent === null) {
        this.root = y;
    } else if (x === x.parent.left) {
        x.parent.left = y;
    } else {
        x.parent.right = y;
    }
    y.parent = x.parent;
   }

   private treeMin(x: Node1<T>): Node1<T> {
    while (x.left !== null) {
        x = x.left;
    }
    return x;
   }

   private deleteFixUp(x: Node1<T>) {
    while (x.parent !== null && x.color === "BLACK") {
        let xParent = x.parent;
        if (x === xParent.left && xParent.right !== null) {
            let s = xParent.right;
            if (s.color === "RED") {
                s.color = "BLACK";
                xParent.color = "RED";
                this.leftRotate(xParent);
                s = xParent.right;
            }
            if (s.left !== null && s.right !== null && s.left.color === "BLACK" && s.right.color === "BLACK") {
                s.color = "RED";
                x = xParent;
            } else {
                if (s.right !== null && s.left !== null && s.right.color == "BLACK") {
                    s.left.color = "BLACK";
                    s.color = "RED";
                    this.rightRotate(s);
                    s = xParent.right;
                }
                s.color = xParent.color;
                xParent.color = "BLACK";
                if (s.right !== null) {
                    s.right.color = "BLACK";
                }
                this.leftRotate(xParent);
            }
        } else if (x === xParent.right && xParent.left !== null) {
            let s = xParent.left;
            if (s.color === "RED") {
                s.color = "BLACK";
                xParent.color = "RED";
                this.rightRotate(xParent);
                s = xParent.left;
            }
            if (s.left !== null && s.right !== null && s.left.color === "BLACK" && s.right.color === "BLACK") {
                s.color = "RED";
                x = xParent;
            } else {
                if (s.right !== null && s.left !== null && s.left.color == "BLACK") {
                    s.right.color = "BLACK";
                    s.color = "RED";
                    this.leftRotate(s);
                    s = xParent.left;
                }
                s.color = xParent.color;
                xParent.color = "BLACK";
                if (s.left !== null) {
                    s.left.color = "BLACK";
                }
                this.rightRotate(xParent);
            }
        }
    }
    x.color = "BLACK";
   }

   public searchNode(k: T): Node1<T> | null {
    let x = this.root;
    while (x !== null && this.compare(k, x.value) !== 0) {
        if (this.compare(k, x.value) < 0) {
            x = x.left;
        } else {
            x = x.right;
        }
    }
    return x;
    }
}